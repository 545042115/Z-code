{
  "name": "@z-assistant/infra-config",
  "version": "0.1.0",
  "private": true,
  "description": "V2 infra — config center (YAML load + env override + validate) and secrets loader. Pure Node (no vscode).",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test \"out/__tests__/*.test.js\"",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@z-assistant/contracts": "0.1.0",
    "@z-assistant/infra-errors": "0.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
