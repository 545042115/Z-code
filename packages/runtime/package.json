{
  "name": "@ziner/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "V2 Assistant Runtime — mechanism layer (trace, storage, cost, errors, permission, config, budget, orchestrator) and framework layer (planning, reflection, context, skills, evaluation, evolution, memory, workflow).",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./orchestrator": {
      "types": "./out/orchestrator/index.d.ts",
      "default": "./out/orchestrator/index.js"
    },
    "./context": {
      "types": "./out/context/index.d.ts",
      "default": "./out/context/index.js"
    },
    "./evaluation": {
      "types": "./out/evaluation/index.d.ts",
      "default": "./out/evaluation/index.js"
    },
    "./evolution": {
      "types": "./out/evolution/index.d.ts",
      "default": "./out/evolution/index.js"
    },
    "./memory": {
      "types": "./out/memory/index.d.ts",
      "default": "./out/memory/index.js"
    },
    "./planning": {
      "types": "./out/planning/index.d.ts",
      "default": "./out/planning/index.js"
    },
    "./workflow": {
      "types": "./out/workflow/index.d.ts",
      "default": "./out/workflow/index.js"
    },
    "./reflection": {
      "types": "./out/reflection/index.d.ts",
      "default": "./out/reflection/index.js"
    },
    "./skills": {
      "types": "./out/skills/index.d.ts",
      "default": "./out/skills/index.js"
    },
    "./skills/skill-parser": {
      "types": "./out/skills/skill-parser.d.ts",
      "default": "./out/skills/skill-parser.js"
    },
    "./errors": {
      "types": "./out/errors/index.d.ts",
      "default": "./out/errors/index.js"
    },
    "./cost": {
      "types": "./out/cost/index.d.ts",
      "default": "./out/cost/index.js"
    },
    "./budget": {
      "types": "./out/budget/index.d.ts",
      "default": "./out/budget/index.js"
    },
    "./config": {
      "types": "./out/config/index.d.ts",
      "default": "./out/config/index.js"
    },
    "./permission": {
      "types": "./out/permission/index.d.ts",
      "default": "./out/permission/index.js"
    },
    "./audit": {
      "types": "./out/audit/index.d.ts",
      "default": "./out/audit/index.js"
    },
    "./storage": {
      "types": "./out/storage/index.d.ts",
      "default": "./out/storage/index.js"
    },
    "./trace": {
      "types": "./out/trace/index.d.ts",
      "default": "./out/trace/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "build:python": "cd python && pyinstaller perception-server.spec --clean",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test \"out/orchestrator/__tests__/*.test.js\" \"out/evolution/__tests__/*.test.js\" \"out/evaluation/__tests__/*.test.js\" \"out/memory/__tests__/*.test.js\" \"out/audit/__tests__/*.test.js\" \"out/permission/__tests__/*.test.js\" \"out/skills/__tests__/*.test.js\" \"out/workflow/__tests__/*.test.js\" \"out/__tests__/*.test.js\"",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ziner/contracts": "0.1.0",
    "@ziner/infra-config": "0.1.0",
    "@ziner/infra-cost": "0.1.0",
    "@ziner/infra-errors": "0.1.0",
    "@ziner/infra-permission": "0.1.0",
    "@ziner/infra-storage": "0.1.0",
    "@ziner/trace": "0.1.0",
    "better-sqlite3": "^12.11.1",
    "dockerode": "^4.0.2",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
