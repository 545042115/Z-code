{
  "name": "@ziner/app-vscode-connector",
  "version": "0.1.0",
  "private": true,
  "description": "V2 VSCode Connector — bridges V1 VSCode extension to V2 Assistant Runtime. V1 extension keeps ownership of activation / panels / commands; this connector is the only bridge point.",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ziner/agent-coding": "0.1.0",
    "@ziner/agent-planner": "0.1.0",
    "@ziner/agent-synthesizer": "0.1.0",
    "@ziner/contracts": "0.1.0",
    "@ziner/infra-cost": "0.1.0",
    "@ziner/infra-storage": "0.1.0",
    "@ziner/runtime": "0.1.0",
    "@ziner/trace": "0.1.0",
    "wechatferry": "^0.0.26",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
