{
  "appId": "com.ziner.desktop",
  "productName": "Ziner",
  "electronVersion": "30.5.1",
  "directories": {
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "node_modules/**/*",
    "!node_modules/electron/**"
  ],
  "asarUnpack": [
    "node_modules/wechatferry/**",
    "node_modules/@wechatferry/**",
    "node_modules/@rustup/**",
    "node_modules/koffi/**"
  ],
  "extraResources": [
  ],
  "fileAssociations": [
    {
      "ext": "zap",
      "name": "Ziner Prompt",
      "description": "Ziner Prompt File",
      "role": "Editor"
    },
    {
      "ext": "zconfig",
      "name": "Ziner Config",
      "description": "Ziner Configuration File",
      "role": "Editor"
    },
    {
      "ext": "zlog",
      "name": "Ziner Trace Log",
      "description": "Ziner Agent Trace Log",
      "role": "Editor"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "win": {
    "icon": "build/icon.ico",
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "target": ["nsis"],
    "sign": false,
    "signDlls": false
  },
  "linux": {
    "icon": "build/icon.png",
    "target": ["AppImage"],
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": {
    "provider": "generic",
    "url": "https://update.ziner.app"
  }
}
