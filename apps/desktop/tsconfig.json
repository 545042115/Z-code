{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "composite": true,
    "tsBuildInfoFile": "./out/.tsbuildinfo",
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["out", "node_modules", "dist"],
  "references": [
    { "path": "../vscode-connector" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/runtime" },
    { "path": "../../packages/agents/browser-agent" }
  ]
}
