    { "path": "../../packages/platform-node" },
    { "path": "../../packages/trace" },
    { "path": "../../packages/agents/browser-agent" },
    { "path": "../../packages/agents/research-agent" },
    { "path": "../../packages/agents/office-agent" },
    { "path": "../../packages/agents/planner-agent" },
    { "path": "../../packages/agents/synthesizer-agent" },
