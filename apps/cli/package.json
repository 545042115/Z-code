{
  "name": "@ziner/app-cli",
  "version": "0.1.0",
  "private": true,
  "description": "V2 CLI — independent program entry point. NOT a VSCode extension. Boots V2 Assistant Runtime for terminal use.",
  "main": "src/index.ts",
  "bin": {
    "z": "src/index.ts"
  },
  "scripts": {
    "build": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "start": "node out/index.js",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ziner/app-vscode-connector": "0.1.0",
    "@ziner/contracts": "0.1.0",
    "@ziner/runtime": "0.1.0",
    "@ziner/trace": "0.1.0"
  }
}
