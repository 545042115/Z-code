{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "baseUrl": ".",
    "paths": {
      "@ziner/contracts": ["packages/contracts/src"],
      "@ziner/contracts/*": ["packages/contracts/src/*"],
      "@ziner/runtime-core": ["packages/runtime-core/src"],
      "@ziner/runtime-core/*": ["packages/runtime-core/src/*"],
      "@ziner/platform-node": ["packages/platform-node/src"],
      "@ziner/platform-node/*": ["packages/platform-node/src/*"],
      "@ziner/platform-web": ["packages/platform-web/src"],
      "@ziner/platform-web/*": ["packages/platform-web/src/*"],
      "@ziner/app-shared": ["packages/app-shared/src"],
      "@ziner/app-shared/*": ["packages/app-shared/src/*"],
      "@ziner/runtime": ["packages/runtime/src"],
      "@ziner/runtime/*": ["packages/runtime/src/*"],
      "@ziner/infra-errors": ["packages/infra/errors/src"],
      "@ziner/infra-errors/*": ["packages/infra/errors/src/*"],
      "@ziner/infra-cost": ["packages/infra/cost/src"],
      "@ziner/infra-cost/*": ["packages/infra/cost/src/*"],
      "@ziner/infra-storage": ["packages/infra/storage/src"],
      "@ziner/infra-storage/*": ["packages/infra/storage/src/*"],
      "@ziner/infra-permission": ["packages/infra/permission/src"],
      "@ziner/infra-permission/*": ["packages/infra/permission/src/*"],
      "@ziner/infra-config": ["packages/infra/config/src"],
      "@ziner/infra-config/*": ["packages/infra/config/src/*"],
      "@ziner/trace": ["packages/trace/src"],
      "@ziner/trace/*": ["packages/trace/src/*"],
      "@ziner/agent-coding": ["packages/agents/coding-agent/src"],
      "@ziner/agent-coding/*": ["packages/agents/coding-agent/src/*"],
      "@ziner/agent-planner": ["packages/agents/planner-agent/src"],
      "@ziner/agent-planner/*": ["packages/agents/planner-agent/src/*"],
      "@ziner/agent-synthesizer": ["packages/agents/synthesizer-agent/src"],
      "@ziner/agent-synthesizer/*": ["packages/agents/synthesizer-agent/src/*"],
      "@ziner/agent-research": ["packages/agents/research-agent/src"],
      "@ziner/agent-research/*": ["packages/agents/research-agent/src/*"],
      "@ziner/agent-office": ["packages/agents/office-agent/src"],
      "@ziner/agent-office/*": ["packages/agents/office-agent/src/*"],
      "@ziner/agent-browser": ["packages/agents/browser-agent/src"],
      "@ziner/agent-browser/*": ["packages/agents/browser-agent/src/*"],
      "@ziner/app-cli": ["apps/cli/src"],
      "@ziner/app-desktop": ["apps/desktop/src"],
      "@ziner/app-vscode-connector": ["apps/vscode-connector/src"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/out",
    "**/dist",
    "**/__tests__",
    "**/*.test.ts",
    "extensions/coding-agent/src",
    "extensions/coding-agent/out",
    "extensions/coding-agent/node_modules"
  ],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/runtime-core" },
    { "path": "./packages/platform-node" },
    { "path": "./packages/platform-web" },
    { "path": "./packages/app-shared" },
    { "path": "./packages/runtime" },
    { "path": "./packages/trace" },
    { "path": "./packages/agents/coding-agent" },
    { "path": "./packages/agents/planner-agent" },
    { "path": "./packages/agents/synthesizer-agent" },
    { "path": "./packages/agents/research-agent" },
    { "path": "./packages/agents/office-agent" },
    { "path": "./packages/agents/browser-agent" },
    { "path": "./apps/cli" },
    { "path": "./apps/desktop" },
    { "path": "./apps/vscode-connector" }
  ]
}
