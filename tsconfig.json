{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "baseUrl": ".",
    "paths": {
      "@z-assistant/contracts": ["packages/contracts/src"],
      "@z-assistant/contracts/*": ["packages/contracts/src/*"],
      "@z-assistant/runtime": ["packages/runtime/src"],
      "@z-assistant/runtime/*": ["packages/runtime/src/*"],
      "@z-assistant/infra-errors": ["packages/infra/errors/src"],
      "@z-assistant/infra-errors/*": ["packages/infra/errors/src/*"],
      "@z-assistant/infra-cost": ["packages/infra/cost/src"],
      "@z-assistant/infra-cost/*": ["packages/infra/cost/src/*"],
      "@z-assistant/infra-storage": ["packages/infra/storage/src"],
      "@z-assistant/infra-storage/*": ["packages/infra/storage/src/*"],
      "@z-assistant/infra-permission": ["packages/infra/permission/src"],
      "@z-assistant/infra-permission/*": ["packages/infra/permission/src/*"],
      "@z-assistant/infra-config": ["packages/infra/config/src"],
      "@z-assistant/infra-config/*": ["packages/infra/config/src/*"],
      "@z-assistant/trace": ["packages/trace/src"],
      "@z-assistant/trace/*": ["packages/trace/src/*"],
      "@z-assistant/agent-coding": ["packages/agents/coding-agent/src"],
      "@z-assistant/agent-coding/*": ["packages/agents/coding-agent/src/*"],
      "@z-assistant/agent-research": ["packages/agents/research-agent/src"],
      "@z-assistant/agent-research/*": ["packages/agents/research-agent/src/*"],
      "@z-assistant/agent-office": ["packages/agents/office-agent/src"],
      "@z-assistant/agent-office/*": ["packages/agents/office-agent/src/*"],
      "@z-assistant/agent-browser": ["packages/agents/browser-agent/src"],
      "@z-assistant/agent-browser/*": ["packages/agents/browser-agent/src/*"],
      "@z-assistant/app-cli": ["apps/cli/src"],
      "@z-assistant/app-desktop": ["apps/desktop/src"],
      "@z-assistant/app-vscode-connector": ["apps/vscode-connector/src"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/out",
    "**/dist",
    "**/__tests__",
    "**/*.test.ts",
    "extensions/coding-agent/src",
    "extensions/coding-agent/out",
    "extensions/coding-agent/node_modules"
  ],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/runtime" },
    { "path": "./packages/trace" },
    { "path": "./packages/agents/coding-agent" },
    { "path": "./packages/agents/research-agent" },
    { "path": "./packages/agents/office-agent" },
    { "path": "./packages/agents/browser-agent" },
    { "path": "./apps/cli" },
    { "path": "./apps/desktop" },
    { "path": "./apps/vscode-connector" }
  ]
}
