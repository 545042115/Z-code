{
  "name": "@z-assistant/trace",
  "version": "0.1.0",
  "private": true,
  "description": "V2 trace — Run/Span lifecycle, persistence orchestration, projection logic, and duck-typed instrumentation. Pure Node (no vscode).",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test \"out/__tests__/*.test.js\"",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@z-assistant/contracts": "0.1.0",
    "@z-assistant/infra-errors": "0.1.0",
    "@z-assistant/infra-cost": "0.1.0",
    "@z-assistant/infra-storage": "0.1.0"
  }
}
