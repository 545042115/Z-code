{
  "name": "@z-assistant/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "V2 Assistant Runtime — mechanism layer (trace, storage, cost, errors, permission, config, budget, orchestrator) and framework layer (planning, reflection, context, skills, evaluation, evolution). workflow/ and memory/ are placeholders for future phases.",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./orchestrator": {
      "types": "./out/orchestrator/index.d.ts",
      "default": "./out/orchestrator/index.js"
    },
    "./context": {
      "types": "./out/context/index.d.ts",
      "default": "./out/context/index.js"
    },
    "./evaluation": {
      "types": "./out/evaluation/index.d.ts",
      "default": "./out/evaluation/index.js"
    },
    "./evolution": {
      "types": "./out/evolution/index.d.ts",
      "default": "./out/evolution/index.js"
    },
    "./planning": {
      "types": "./out/planning/index.d.ts",
      "default": "./out/planning/index.js"
    },
    "./reflection": {
      "types": "./out/reflection/index.d.ts",
      "default": "./out/reflection/index.js"
    },
    "./skills": {
      "types": "./out/skills/index.d.ts",
      "default": "./out/skills/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test \"out/orchestrator/__tests__/*.test.js\" \"out/evolution/__tests__/*.test.js\" \"out/evaluation/__tests__/*.test.js\"",
    "clean": "rm -rf out dist *.tsbuildinfo"
  },
  "dependencies": {
    "@z-assistant/contracts": "0.1.0",
    "@z-assistant/infra-cost": "0.1.0",
    "@z-assistant/infra-errors": "0.1.0",
    "@z-assistant/infra-storage": "0.1.0",
    "@z-assistant/trace": "0.1.0"
  }
}
